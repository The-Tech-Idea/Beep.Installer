    {
      "id": "driver-device-in-use",
      "category": "driver",
      "description": "Exercise install/uninstall while the transport environment prepares device-in-use conditions for cleanup evidence.",
      "requiredArtifacts": ["msi"],
      "actions": ["driver-store-before", "msi-install", "driver-store-after-install", "msi-uninstall", "driver-store-after-uninstall"],
