<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Beep.Installer.Extensions.WPF</AssemblyName>
    <RootNamespace>Beep.Installer.Extensions.WPF</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>The Tech Idea</Authors>
    <Company>The Tech Idea</Company>
    <Product>Beep Installer Extensions (WPF)</Product>
    <Description>
      Drop-in WPF UI for post-install app features — chiefly self-update — built on the BeepDM
      app-update service (TheTechIdea.Beep.Updates) and the Beep WPF controls. A developer adds one
      call to give their app an "update available" prompt with progress.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DataManagementModels/Engine referenced DIRECTLY (source) so the Updates domain wins over the
      NuGet TheTechIdea.Beep.DataManagementModels 3.1.1 that TheTechIdea.Beep.WPF.Controls pulls in
      — otherwise nearest-to-root resolves the stale package and the Updates types disappear at
      runtime. Repo Directory.Build.props carries the matching NoWarn NU1605.
    -->
    <ProjectReference Include="..\..\BeepDM\DataManagementModelsStandard\DataManagementModels.csproj" />
    <ProjectReference Include="..\..\BeepDM\DataManagementEngineStandard\DataManagementEngine.csproj" />
    <ProjectReference Include="..\..\Beep.Winform\TheTechIdea.Beep.Vis.Modules2.0\TheTechIdea.Beep.Vis.Modules.csproj" />
    <ProjectReference Include="..\..\Beep.WPF\TheTechIdea.Beep.WPF.Controls\TheTechIdea.Beep.WPF.Controls.csproj" />
  </ItemGroup>

</Project>
