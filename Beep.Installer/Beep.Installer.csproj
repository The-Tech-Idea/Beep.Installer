<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Beep.Installer</AssemblyName>
    <RootNamespace>Beep.Installer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>The Tech Idea</Authors>
    <Company>The Tech Idea</Company>
    <Product>Beep Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Authoring/build/packaging logic, deliberately free of any UI dependency. -->
    <ProjectReference Include="..\Beep.Installer.Core\Beep.Installer.Core.csproj" />
    <ProjectReference Include="..\..\Beep.Winform\TheTechIdea.Beep.Vis.Modules2.0\TheTechIdea.Beep.Vis.Modules.csproj" />
    <!--
      DataManagementModels must be referenced DIRECTLY, not just transitively via
      DataManagementEngine. Beep.Winform.Controls and Vis.Modules PackageReference
      TheTechIdea.Beep.DataManagementModels at the same assembly identity (3.1.1.0) as the
      source build, and NuGet resolves nearest-to-root: without this line the stale package
      wins and the app fails at runtime with TypeLoadException on newer BeepDM types.
      Same fix used by Beep.Desktop.Common, Beep.Winform.Data.Integrated, TreeNodes, MVVM.
    -->
    <ProjectReference Include="..\..\BeepDM\DataManagementModelsStandard\DataManagementModels.csproj" />
    <ProjectReference Include="..\..\BeepDM\DataManagementEngineStandard\DataManagementEngine.csproj" />
    <ProjectReference Include="..\..\Beep.Winform\TheTechIdea.Beep.Winform.Controls\TheTechIdea.Beep.Winform.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="install-config.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
