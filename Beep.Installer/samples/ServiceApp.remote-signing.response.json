{
  "build": "Beep.Installer\\samples\\ServiceApp.bsetup",
  "policy": "Beep.Installer\\samples\\enterprise-policy.sample.json",
  "out": "Beep.Installer\\samples\\remote-signed-build",
  "signRemoteProvider": "enterprise-hsm",
