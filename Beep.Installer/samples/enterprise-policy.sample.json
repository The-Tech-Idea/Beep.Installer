{
  "schemaVersion": "1.0",
  "name": "Sample enterprise policy",
  "requireSignedInstaller": false,
  "requireTimestamp": false,
  "timestampOutagePolicy": "fail",
  "requireLicenseMetadata": false,
  "requireSbom": false,
  "requireProvenance": false,
  "forbidLiteralSecrets": true,
  "forbidCustomActions": true,
  "forbidRemotePayloads": true,
  "forbidUnsignedDrivers": true,
  "requireExtensionSignatures": false,
  "requireSupplyChainScan": false,
  "requireDeclaredPayloadHashes": false,
  "requireSignedArtifacts": false,
  "requireMalwareScan": false,
  "requireVulnerabilityScan": false,
  "requireSignedPolicy": false,
  "requireUpdateUrl": false,
  "forbidInsecureRemoteSources": true,
  "requireSignedPrerequisiteCatalogs": true,
  "requirePinnedPrerequisiteCatalogHashes": true,
  "requireOfflineLayoutProxy": false,
  "requireSecretReferencedOfflineLayoutAuth": false,
  "allowBuiltInPrerequisiteCatalogs": false,
  "allowIisFeatureEnablement": true,
  "maxOfflineLayoutCacheRetentionDays": 30,
  "telemetryMode": "disabled",
  "telemetryEndpoint": "",
  "allowedUpdateChannels": [ "stable", "internal" ],
  "allowedUpdateModes": [ "optional", "required" ],
  "allowedUpdateHosts": [],
  "allowedRemoteSourceHosts": [
    "builds.dotnet.microsoft.com",
    "download.visualstudio.microsoft.com"
  ],
  "allowedTelemetryHosts": [],
  "allowedTimestampHosts": [
    "timestamp.digicert.com"
  ],
  "allowedMsiCustomActionFamilies": [],
  "allowedPrerequisiteCatalogs": [ "acme.runtimes@2026.09.01" ],
  "allowedIisFeatures": [
    "IIS-WebServerRole",
    "IIS-WebServer",
    "IIS-CommonHttpFeatures",
    "IIS-StaticContent",
    "IIS-ApplicationDevelopment",
    "IIS-NetFxExtensibility45",
    "IIS-ISAPIExtensions",
    "IIS-ISAPIFilter",
    "IIS-ManagementScriptingTools"
  ],
  "trustedPrerequisiteCatalogIssuers": [ "CN=The Tech Idea Catalog Authority" ],
  "trustedPrerequisiteCatalogPublicKeys": [],
  "trustedPrerequisiteCatalogPublicKeyPaths": [ "keys/catalog-public.pem" ],
  "allowUnsignedOfflineLayouts": false,
  "offlineLayoutTrustedPublicKeyPath": "keys/layout-public.pem",
  "offlineLayoutTrustedPublicKey": "",
  "offlineLayoutCacheRetentionDays": 30,
  "offlineLayoutProxyUri": "",
  "offlineLayoutProxyUsername": "",
  "offlineLayoutProxyPassword": "secret://env/LAYOUT_PROXY_PASSWORD",
  "offlineLayoutBearerToken": "secret://env/LAYOUT_BEARER_TOKEN",
  "offlineLayoutHeaderName": "",
  "offlineLayoutHeaderValue": "secret://env/LAYOUT_HEADER_TOKEN",
  "unsupportedMsiOperationSeverity": "error",
  "policyIssuer": "CN=The Tech Idea Policy Authority",
  "policySignature": "",
  "requiredFileSha256": {},
  "deniedSha256": [],
  "allowedArtifactSignerSubjects": [ "CN=The Tech Idea" ],
  "trustedPolicyIssuerSubjects": [ "CN=The Tech Idea Policy Authority" ],
  "trustedPolicySigningPublicKeys": [],
  "trustedWaiverPublicKeys": [],
  "trustedEmergencyOverridePublicKeys": [],
  "supplyChainWaivers": [],
  "emergencyOverrides": [],
  "allowedPublishers": [ "The Tech Idea" ],
  "allowedScopes": [ "machine" ],
  "allowedOutputFormats": [ "exe", "msix", "msixbundle" ],
  "allowedExtensionPublishers": [ "The Tech Idea" ],
  "deniedExtensionPermissions": 32
}
